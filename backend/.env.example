# ── Server ──────────────────────────────────────
# Required: shared secret the device sends as the X-Device-Token header. If unset,
# the backend rejects uploads with 503 unless ALLOW_NO_DEVICE_TOKEN=1 is also set.
DEVICE_TOKEN=your-secret-token-here        # must match device .env
# ALLOW_NO_DEVICE_TOKEN=1                   # opt out of auth — throwaway local testing only
UPLOAD_DIR=/tmp/shower_uploads

# ── AI ─────────────────────────────────
AI_PROVIDER=anthropic                      # "anthropic" | "openai"
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                      # needed for Whisper transcription always

# ── Notes Adapter ────────────────────────
NOTES_ADAPTER=apple_notes                  # apple_notes | notion | obsidian | email | craft

# Apple Notes (macOS only — backend must run on a Mac signed into iCloud).
# Drives the Notes app via AppleScript. NOTE: there is no email-to-Apple-Notes
# address; emailing iCloud does NOT create a note. The folder is auto-created.
APPLE_NOTES_FOLDER=Shower Thoughts

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obsidian (file strategy)
OBSIDIAN_STRATEGY=file
OBSIDIAN_VAULT_PATH=/Users/you/MyVault
OBSIDIAN_FOLDER=Shower Thoughts

# Obsidian (webhook strategy)
# OBSIDIAN_STRATEGY=webhook
# OBSIDIAN_API_URL=https://127.0.0.1:27123
# OBSIDIAN_API_KEY=your-local-rest-api-key

# Craft (url_scheme — macOS only, backend must run on same Mac as Craft)
CRAFT_STRATEGY=url_scheme
CRAFT_SPACE_ID=your-space-id

# Craft (shortcuts — backend on any machine, Shortcuts listener on Mac/iPhone)
# CRAFT_STRATEGY=shortcuts
# CRAFT_SPACE_ID=your-space-id
# CRAFT_SHORTCUTS_WEBHOOK_URL=http://192.168.1.5:8888

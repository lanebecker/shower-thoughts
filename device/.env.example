BACKEND_URL=http://192.168.1.100:8000
DEVICE_TOKEN=your-secret-token-here

# Optional: low-battery LED via an I2C ADC (ADS1115) reading the LiPo voltage.
# Leave BATTERY_MONITOR unset to disable (the default).
# BATTERY_MONITOR=1
# BATTERY_LOW_THRESHOLD=3.5       # volts; amber LED cue at/below this
# BATTERY_CHECK_INTERVAL_S=300    # how often to sample
# BATTERY_I2C_BUS=1
# BATTERY_I2C_ADDR=0x48           # ADS1115 default address
# BATTERY_ADC_CHANNEL=0           # AIN0..AIN3 that the divider feeds
# BATTERY_DIVIDER_RATIO=2.0       # Vbattery / Vadc (two equal resistors = 2.0)
